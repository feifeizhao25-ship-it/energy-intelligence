# Application
APP_NAME=新能源智库
APP_ENV=development
DEBUG=true
VERSION=2.0.0

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database
DATABASE_URL=postgresql+asyncpg://<db_user>:<db_password>@localhost:5432/energy_intelligence
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=50

# JWT
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem

# Security
SECRET_KEY=<generate-a-strong-random-secret-key>
PASSWORD_MIN_LENGTH=8

# Rate Limiting
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# External APIs
NASA_POWER_API_URL=https://power.larc.nasa.gov/api
SMS_API_KEY=your-sms-api-key
SMS_API_SECRET=your-sms-api-secret

# AI / LLM Providers (optional — required for AI chat features)
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
DASHSCOPE_API_KEY=your-dashscope-api-key
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Feature Flags
ENABLE_AI_CHAT=true
ENABLE_ADVANCED_DIAGNOSTICS=false
ENABLE_REALTIME_SIMULATION=false

# Payments (optional)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRO_PRICE_ID=price_xxx
STRIPE_ENTERPRISE_PRICE_ID=price_xxx
ALIPAY_APP_ID=your-alipay-app-id
WECHAT_PAY_MCH_ID=your-wechat-mch-id

# Vector DB (optional)
PINECONE_API_KEY=your-pinecone-key
PINECONE_ENVIRONMENT=us-east-1
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Observability (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=your-sentry-dsn
DATADOG_API_KEY=your-datadog-api-key

# Push Notifications (optional)
FCM_SERVER_KEY=your-fcm-key
JPUSH_APP_KEY=your-jpush-key
JPUSH_MASTER_SECRET=your-jpush-secret

# Maps (optional)
GAODE_MAP_KEY=your-gaode-key

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
