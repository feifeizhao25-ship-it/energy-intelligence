ENVIRONMENT=production
MARKET_REGION=global
DEBUG=false
SECRET_KEY=<generate-at-deploy-time-with-at-least-32-random-characters>
DATABASE_URL=postgresql+asyncpg://energy_app:<password>@postgres.internal:5432/energy
REDIS_URL=redis://redis.internal:6379/0
CORS_ORIGINS=["https://energy.example.com","https://global.energy.example.com"]
VECTOR_STORE_BACKEND=milvus
MILVUS_HOST=milvus.internal
MILVUS_PORT=19530
MILVUS_COLLECTION=knowledge_documents
STORAGE_PROVIDER=s3
S3_BUCKET=<production-private-bucket>
AWS_REGION=<aws-region>
