{
  "name": "energy-intelligence",
  "version": "1.0.0",
  "private": true,
  "description": "新能源智库 - AI-powered renewable energy assessment platform",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "test": "turbo run test",
    "test:unit": "pnpm --filter energy-intelligence-global test",
    "test:unit:coverage": "pnpm --filter energy-intelligence-global test",
    "test:integration": "jest --config tests/jest.config.js --selectProjects=integration",
    "test:integration:coverage": "jest --config tests/jest.config.js --selectProjects=integration --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:coverage": "jest --config tests/jest.config.js --coverage",
    "test:ci": "turbo run test",
    "test:load": "k6 run tests/load/api-load.js",
    "test:load:chat": "k6 run tests/load/chat-load.js",
    "test:load:skill": "k6 run tests/load/skill-load.js",
    "test:watch": "jest --config tests/jest.config.js --watch",
    "test:clear": "jest --config tests/jest.config.js --clearCache",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:migrate": "cd apps/api && npx prisma migrate dev",
    "db:generate": "cd apps/api && npx prisma generate",
    "db:seed": "cd apps/api && npx prisma db seed",
    "db:studio": "cd apps/api && npx prisma studio",
    "prepare": "husky install || true",
    "commit": "git-cz",
    "precommit": "lint-staged",
    "quality:check": "pnpm lint && pnpm format:check && pnpm type-check",
    "quality:fix": "pnpm lint:fix && pnpm format",
    "sonar:scan": "sonar-scanner",
    "security:audit": "pnpm audit --audit-level=high",
    "verify:production": "python3 scripts/verify_production_code.py && python3 scripts/verify_k8s_production.py && python3 scripts/verify_compose_production.py"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.4.0",
    "@commitlint/config-conventional": "^18.4.0",
    "@faker-js/faker": "^10.5.0",
    "@jest/globals": "^30.3.0",
    "@playwright/test": "^1.40.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-security": "^1.7.1",
    "eslint-plugin-unused-imports": "^3.0.0",
    "fishery": "^2.2.2",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "jest-extended": "^4.0.0",
    "jest-mock-extended": "^3.0.5",
    "lint-staged": "^15.2.0",
    "playwright": "^1.40.0",
    "prettier": "^3.1.0",
    "supertest": "^6.3.0",
    "testcontainers": "^11.14.0",
    "ts-jest": "^29.1.0",
    "turbo": "^1.11.0",
    "typescript": "^5.3.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "packageManager": "pnpm@8.12.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "renewable-energy",
    "solar",
    "wind",
    "energy-storage",
    "ai",
    "financial-analysis"
  ],
  "pnpm": {
    "overrides": {
      "fast-jwt": "^6.2.4",
      "fastify": "^5.8.5",
      "fast-uri": "^3.1.5",
      "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
      "protobufjs": "^7.5.5",
      "tar-fs": "^3.1.2",
      "ws": "^8.20.0",
      "undici": "^7.24.5",
      "lodash": "^4.18.0",
      "glob": "^10.5.0",
      "minimatch": "^9.0.7",
      "fast-xml-builder": "^1.1.7",
      "fast-xml-parser": "^5.7.0",
      "thrift": "^0.23.0",
      "@xmldom/xmldom": "^0.8.13",
      "basic-ftp": "^5.3.1",
      "sharp": "^0.35.0",
      "postcss": "^8.5.23",
      "brace-expansion@>=2.0.0 <2.1.4": "^2.1.4",
      "brace-expansion@<2.0.0": "^1.1.12",
      "js-yaml@>=4.0.0 <4.3.1": "^4.3.1",
      "js-yaml@<4.0.0": "^3.15.1",
      "nanoid@<3.3.18": "^3.3.18"
    }
  },
  "_workspaces_note": "网页端-国内版 / 网页端-国际版 已从 workspaces 移除——两者分别只有 2 个和 0 个源文件，是废弃空壳。国内版主前端是 runtime/web（57 页），国际版是 runtime/web-int，二者各自带 package-lock.json 独立用 npm 构建，与 runtime/docker-compose.production.yml 的 build context 一致，故不纳入 pnpm workspace。",
  "workspaces": [
    "web-global",
    "packages/*",
    "apps/*"
  ]
}
