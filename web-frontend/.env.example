# AI 服务配置
# 选择 AI 提供商: 'siliconflow' (推荐) 或 'openrouter'
AI_PROVIDER=siliconflow

# 硅基流动 (SiliconFlow) - 支持 DeepSeek V3, Qwen 2.5, GLM-4
# 注册地址: https://cloud.siliconflow.cn/
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter - 支持 Claude 3.5 Sonnet, GPT-4o
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 地图服务
# 高德地图 API Key (Web端(JSAPI))
NEXT_PUBLIC_AMAP_KEY=your_amap_key_here

# 科学计算 API
# NASA POWER (无需 Key，但在某些网络下可能需要代理)
# Semantic Scholar (建议申请 Key 以提高限额)
SEMANTIC_SCHOLAR_API_KEY=
