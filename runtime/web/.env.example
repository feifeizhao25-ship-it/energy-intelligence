NEXT_PUBLIC_APP_EDITION=cn
NEXT_PUBLIC_API_URL=/api/backend
# 【必填】登录服务配置。缺失时全站登录 fail-closed：
# /api/auth/* 返回 503 configured:false，登录页展示中文未配置提示。
# NEXTAUTH_URL 必须是生产站点的真实外网地址，禁止填 localhost 兜底进生产。
NEXTAUTH_URL=https://cn.example.com
# 【必填】至少 32 位随机串（openssl rand -base64 32）
NEXTAUTH_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://energy:replace-me@postgres:5432/energy
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SENTRY_DSN=
# dashboard demo 预览：=1 时中间件仅放行 /dashboard 单页（人设预览，勿在生产开启）
NEXT_PUBLIC_DEMO_PERSONA_PREVIEW=
# 地图审图号。留空时界面显示未配置，不要填猜测编号。
NEXT_PUBLIC_MAP_APPROVAL_NO=
# 页脚版本号，构建时写入提交号。
NEXT_PUBLIC_GIT_SHA=

# 位置服务只在服务端用。国内版默认腾讯；LOCATION_PROVIDER=amap 切回高德。
LOCATION_PROVIDER=tencent
MAP_TILE_PROVIDER=tencent
AMAP_WEB_SERVICE_KEY=
GAODE_MAP_KEY=
TENCENT_MAP_KEY=
# 腾讯控制台开了签名校验才填
TENCENT_MAP_SK=
# 不要把真实密钥写进仓库。产品走服务端 TENCENT_MAP_KEY，前端包不读取下面这一项。
# 只有必须在浏览器加载腾讯 JS SDK 时，才在部署环境单独填写，且不要提交。
NEXT_PUBLIC_TENCENT_MAP_KEY=
# 网页与 App 问答共用的本地中文向量。权重放 LOCAL_EMBEDDING_CACHE_DIR；没有权重时自动退回词面检索，不在请求里下载模型。
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
LOCAL_EMBEDDING_CACHE_DIR=
LOCAL_EMBEDDING_OFFLINE=1
RAG_VECTOR_RESCUE=1
