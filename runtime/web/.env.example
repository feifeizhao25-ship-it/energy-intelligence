NEXT_PUBLIC_APP_EDITION=cn
NEXT_PUBLIC_API_URL=/api/backend
# 【必填】登录服务配置。缺失时全站登录 fail-closed：
# /api/auth/* 返回 503 configured:false，登录页展示中文未配置提示。
# NEXTAUTH_URL 必须是生产站点的真实外网地址，禁止填 localhost 兜底进生产。
NEXTAUTH_URL=https://cn.example.com
# 【必填】至少 32 位随机串（openssl rand -base64 32）
NEXTAUTH_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://energy:replace-me@postgres:5432/energy
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SENTRY_DSN=
# dashboard demo 预览：=1 时中间件仅放行 /dashboard 单页（人设预览，勿在生产开启）
NEXT_PUBLIC_DEMO_PERSONA_PREVIEW=
