{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rag_source.schema.json",
  "title": "新能源智库来源元数据 v2",
  "type": "object",
  "required": [
    "source_id", "type", "lang", "title", "doc_number", "issuer",
    "publish_date", "effective_date", "expiry_date", "status", "superseded_by",
    "jurisdiction", "source_tier", "license", "snapshot_sha256", "last_verified_at",
    "source_url", "content"
  ],
  "properties": {
    "source_id": {"type": "string", "minLength": 1},
    "doc_number": {"type": "string", "minLength": 1},
    "issuer": {"type": "string", "minLength": 1},
    "publish_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "effective_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "expiry_date": {"type": ["string", "null"]},
    "status": {"enum": ["现行", "征求意见", "废止", "被替代", "待核实"]},
    "superseded_by": {"type": ["string", "null"]},
    "jurisdiction": {"enum": ["全国", "省", "市", "海外"]},
    "source_tier": {"enum": ["一手官方", "协会", "媒体", "学术"]},
    "license": {"type": "string", "minLength": 1},
    "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "last_verified_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "source_url": {"type": "string", "minLength": 8}
  },
  "additionalProperties": true
}
