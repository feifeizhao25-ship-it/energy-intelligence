ENVIRONMENT=production
DEBUG=false
SECRET_KEY=replace-with-at-least-32-random-characters
CORS_ORIGINS=["https://cn.example.com","https://global.example.com"]
DATABASE_URL=postgresql+asyncpg://energy:replace-me@postgres:5432/energy
REDIS_URL=redis://:replace-me@redis:6379/0
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_FAST=qwen/qwen3-30b-a3b-instruct-2507
OPENROUTER_MODEL_QUALITY=deepseek/deepseek-v3.2
# 国内生产只能配置直连境内供应商，OpenRouter 仅用于国际用户。
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=
STRIPE_SUCCESS_URL=http://localhost:3000/billing/success
STRIPE_CANCEL_URL=http://localhost:3000/billing/cancel
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/membership
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://api.example.cn/api/v1/billing/domestic/alipay/notify
ALIPAY_RETURN_URL=https://example.cn/membership/result
ALIPAY_SANDBOX=true
SENDGRID_API_KEY=
SENTRY_DSN=
# 评测门禁读取的最新结果文件。只写变量名，不写密钥。
NENGJIAN_EVAL_LATEST=
NENGJIAN_WECOM_ROBOT_KEY=
WECOM_TPL_BUSINESS=
# 公开数据抓取联系邮箱，写入 User-Agent。留空则不发起外网抓取。
CRAWLER_CONTACT_EMAIL=
# 公开数据定时抓取。填 1 才执行；留空视为关闭。
PUBLIC_INGESTION_ENABLED=
# 快照目录与入库库文件。留空时使用服务默认路径。
NENGJIAN_PUBLIC_SNAPSHOT_DIR=
NENGJIAN_PUBLIC_INGEST_DB=
# 国内版默认关闭境外实时调用。三项同时为 1 才允许。
OVERSEAS_LIVE=
OVERSEAS_PRIVACY_ACK=
OVERSEAS_PIA_RECORD=
# 以下只写变量名。未填写时缓存、统计和收费入口保持关闭。
NENGJIAN_ANSWER_CACHE=
NENGJIAN_ICP_LICENSE=
NENGJIAN_UMAMI_URL=
NENGJIAN_QWEN_JUDGE_MODEL=
# 向量。auto：国内版且有百炼密钥时用 text-embedding-v4；配置了方舟密钥和下面的模型名时用方舟；否则本地 BAAI/bge-small-zh-v1.5。模型加载失败时用字符 n-gram，不访问境外向量接口。
EMBEDDING_PROVIDER=auto
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
NENGJIAN_ARK_EMBEDDING_MODEL=
EMBEDDING_LOCAL_ENGINE=auto
WECOM_TPL_POLICY=
WECOM_TPL_PUBLISH=
WECOM_TPL_QUOTE=
WECOM_TPL_REFUND=
WECOM_TPL_ERRATUM=
WECOM_TPL_SAMPLE=
