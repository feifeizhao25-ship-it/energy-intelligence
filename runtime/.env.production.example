IMAGE_TAG=local
IMAGE_REGISTRY=ghcr.io/your-organization
CN_DOMAIN=energy.example.com
INT_DOMAIN=global.energy.example.com
TLS_EMAIL=ops@example.com
CN_PUBLIC_API_URL=https://api.energy.example.com
POSTGRES_PASSWORD=replace_with_a_long_random_database_password
REDIS_PASSWORD=replace_with_a_long_random_redis_password
SECRET_KEY=replace_with_at_least_32_random_characters
NEXTAUTH_SECRET=replace_with_a_different_32_character_secret
CORS_ORIGINS=https://cn.example.com,https://global.example.com
CN_NEXTAUTH_URL=https://cn.example.com
OPENALEX_CONTACT_EMAIL=research@example.com

# ══════════════════════════════════════════════════════════════
# 这个文件同时服务国内栈与国际栈，所以下面按市场分区。
# 口径（2026-09-21）：**国内版只接国内的模型和数据库。**
# 分区不是装饰——docker-compose.cn.production.yml 只消费"国内"那一段，
# 并且构建期 validate-public-build-config.mjs 会拒绝国内版出现 SUPABASE_*。
# ══════════════════════════════════════════════════════════════

# ── 国内栈：模型 ────────────────────────────────────────────────
# web 固定走硅基流动的境内端点（src/lib/ai/domestic-endpoint.ts 把地址
# 锁死在 api.siliconflow.cn，配成别的地址会直接抛错），后端另用这三家。
SILICONFLOW_API_KEY=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=

# ── 国内栈：数据库 ──────────────────────────────────────────────
# 只接自建 PostgreSQL，连接信息走上面的 POSTGRES_PASSWORD
# （Prisma 与 NextAuth 用的就是它）。国内栈**不配** SUPABASE_*。

# ── 国内栈：收单 ────────────────────────────────────────────────
# 支付宝，见下方 ALIPAY_*。

# ── 国际栈 ONLY：以下变量不要出现在国内栈的 .env 里 ─────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_FAST=qwen/qwen3-30b-a3b-instruct-2507
OPENROUTER_MODEL_QUALITY=deepseek/deepseek-v3.2
OPENROUTER_FALLBACK_MODELS=qwen/qwen3-30b-a3b-instruct-2507,google/gemini-2.5-flash
OPENROUTER_SITE_URL=https://xinnengyuan.ai
OPENROUTER_CIRCUIT_FAILURES=3
OPENROUTER_CIRCUIT_COOLDOWN_SECONDS=60
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://xinnengyuan.ai/billing/success
STRIPE_CANCEL_URL=https://xinnengyuan.ai/billing/cancel
STRIPE_PORTAL_RETURN_URL=https://xinnengyuan.ai/membership
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
# PEM 内容可使用字面量 \\n 表示换行，禁止提交真实密钥。
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://api.xinnengyuan.ai/api/v1/billing/domestic/alipay/notify
ALIPAY_RETURN_URL=https://xinnengyuan.ai/membership/result
SENDGRID_API_KEY=
SENTRY_DSN=
FORWARDED_ALLOW_IPS=127.0.0.1

# Server-only geocoding/weather keys. Never place these in NEXT_PUBLIC_* variables.
AMAP_WEB_SERVICE_KEY=
OPENWEATHERMAP_API_KEY=
