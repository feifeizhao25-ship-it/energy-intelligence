<view class="page">
  <view class="title">短信登录</view>
  <input placeholder="手机号" value="{{phone}}" bindinput="onPhone" />
  <input placeholder="验证码" value="{{code}}" bindinput="onCode" />
  <checkbox-group bindchange="onConsent">
    <label><checkbox value="yes" />同意接收验证码并用于登录</label>
  </checkbox-group>
  <button bindtap="send">获取验证码</button>
  <button bindtap="login">登录</button>
  <view class="note">{{message}}</view>
</view>
