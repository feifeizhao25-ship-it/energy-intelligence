# 新能源智库 — 生产环境变量示例
# 对应 runtime/docker-compose.production.yml。
# 用法: cp deploy/env.production.example .env.production 后逐项填真实值（本文件不含任何真实值）。

# ── 必需（compose 中 :? 声明，缺失会直接拒绝启动）─────────────────────────

# PostgreSQL 密码（postgres 服务，同时拼入 backend/web-cn 的 DATABASE_URL）
POSTGRES_PASSWORD=

# Redis 密码（redis 服务 --requirepass，同时拼入 backend 的 REDIS_URL）
REDIS_PASSWORD=

# 后端 JWT/会话签名密钥（足够长的随机串）
SECRET_KEY=

# 后端允许的跨域来源，必须是 JSON 数组
CORS_ORIGINS=["https://energy-thinktank.com","https://cn.energy-thinktank.com"]

# 【必填】国内站 NextAuth 回调地址（如 https://energyiq.<主域>）；禁止 localhost 兜底，缺失时登录 fail-closed
CN_NEXTAUTH_URL=

# 【必填】NextAuth 会话加密密钥（openssl rand -base64 32）
NEXTAUTH_SECRET=

# Supabase 项目 URL（web-cn 用户体系）
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon 公钥
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role 密钥（仅服务端，切勿泄露到前端）
SUPABASE_SERVICE_ROLE_KEY=

# 生产向量库
VECTOR_STORE_BACKEND=milvus
MILVUS_HOST=
MILVUS_PORT=19530

# 阿里云 OSS（生产存储必需）
OSS_BUCKET=
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ── 可选（compose 中有默认值或允许为空）───────────────────────────────────

# 镜像 tag，部署/回滚时指定（scripts/rollback.sh 也用同一个变量）
IMAGE_TAG=local

# 宿主端口映射
CN_WEB_PORT=3300
INT_WEB_PORT=3400

# 后端可信反代 IP（Caddy 与 backend 同机/同网段时收紧）
FORWARDED_ALLOW_IPS=127.0.0.1

# LLM / 第三方服务密钥（按需填写，留空即关闭对应功能）
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
SILICONFLOW_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SENDGRID_API_KEY=
SENTRY_DSN=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@energy-thinktank.com

# ── 备份（scripts/backup/backup.sh，cron 环境中配置）──────────────────────

# 异地（Cloudflare R2 / S3）目标；留空则跳过异地上传
# rclone 示例: r2:bucket/energy    aws s3 示例: s3://bucket/energy
R2_REMOTE=

# 备份失败 Telegram 告警（两个都设置才生效）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 镜像、域名及正式支付宝配置（此前示例遗漏，Compose 必填）──────────
# 镜像仓库填入已验证可访问的仓库路径；阿里云可使用已配置的 ACR 命名空间。
IMAGE_REGISTRY=
# IMAGE_TAG 请将上面的 local 替换为待验收的固定提交标签。
CN_DOMAIN=
INT_DOMAIN=
TLS_EMAIL=
CN_PUBLIC_API_URL=
OPENALEX_CONTACT_EMAIL=
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=

# 国内模型服务，按实际选择配置；当前示例不表示已接通。
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=

# NEXT_PUBLIC_* 在镜像构建时固化，修改后须重新构建。
# NEXT_PUBLIC_SUPABASE_ANON_KEY 只能填写公开 anon / publishable key。
# 不得将 SUPABASE_SERVICE_ROLE_KEY 或任何私钥作为 Docker build-arg。
# 当前 Compose 包含国际站和 INT_DOMAIN，尚不是独立的国内隔离部署拓扑。
